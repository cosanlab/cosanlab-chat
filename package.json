{
  "name": "cosanlab-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only database --project demo-cosanlab 'vitest run test/rules.test.js -c vitest.rules.config.js'",
    "e2e": "firebase emulators:exec --only database,auth --project demo-cosanlab 'playwright test'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "firebase-tools": "^13.0.0",
    "svelte": "^5.16.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  }
}
